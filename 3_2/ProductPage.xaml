<Page x:Class="WpfApp2.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Arial" FontSize="12">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" >
            <TextBlock Text="Поиск" Width="150" Height="30" FontSize="16" TextAlignment="Right" Margin="20" />
            <TextBox Name="SearchTB" TextChanged="SearchTB_TextChanged" Width="200" Height="30" FontSize="16" />

            <TextBlock Text="Сортировка" Width="150" Height="30" FontSize="16" TextAlignment="Right" Margin="20" />
            <ComboBox Name="SortCB"  Width="200" Height="30" FontSize="16" SelectionChanged="ComboBox_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" />
                <ComboBoxItem Content="По убыванию количества" />
                <ComboBoxItem Content="По возрастанию количества" />
                <ComboBoxItem Content="По убыванию цены" />
                <ComboBoxItem Content="По возрастанию цены" />
                <ComboBoxItem Content="По убыванию скидки" />
                <ComboBoxItem Content="По возрастанию скидки" />
            </ComboBox>

            <TextBlock Text="Фильтрация" Width="150" Height="30" FontSize="16" TextAlignment="Right" Margin="20" />
            <ComboBox Name="FiltCB" Width="200" Height="30" FontSize="16" SelectionChanged="ComboBox_SelectionChanged">
                <ComboBoxItem Content="Все диапазоны" />
                <ComboBoxItem Content="Скидка 0 - 1.99%" />
                <ComboBoxItem Content="Скидка 12 - 18.99%" />
                <ComboBoxItem Content="Скидка 19 и более" />
            </ComboBox>
        </StackPanel>
        
        <ListView Grid.Row="1" Name="ProductsListView" HorizontalAlignment="Left" Margin="0,0,0,150">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Background="{Binding DiscountColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="800" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.RowSpan="7" Width="150" Height="150" Source="{Binding PhotoPath}" />
                        
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CategoryName}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DescriptionDevided, StringFormat='Описание товара: {0}'}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Manufacturers.Name, StringFormat='Производитель: {0}'}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Suppliers.Name, StringFormat='Поставщик: {0}'}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Cost, StringFormat='Цена: {0}'}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Unit, StringFormat='Единица измерения: {0}'}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Count, StringFormat='Количество на складе: {0}'}" />

                        <TextBlock Grid.RowSpan="7" Grid.Column="2" Text="{Binding Discount, StringFormat='Действующая скидка: {0}%'}" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="1">
                            <Button Name="DeleteButton" Content="Удалить" Background="#4B0082" Width="150" FontSize="16" Margin="10" Click="EditButton_Click" />
                            <Button Name="EditButton" Content="Редактировать" Background="#4B0082" Width="150" FontSize="16" Margin="10" Click="EditButton_Click_1" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
